{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FinanceApp": {
    "BaseUrl": "http://localhost:5031/mock-finance/"
  },
  "AtRisk": {
    "ThresholdMinutes": 15
  },
  "FinanceStub": {
    "FailFirstAttempts": 0
  },
  "Jwt": {
    "Issuer": "JobScheduler",
    "Audience": "JobScheduler.Web",
    "ExpiryMinutes": 60
  }
}
